rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function teamData(id) {
      return get(/databases/$(database)/documents/teams/$(id)).data;
    }

    function isMember(id) {
      return request.auth != null
        && request.auth.uid in teamData(id).memberIds;
    }

    function isTeamOwner(id) {
      return request.auth != null
        && teamData(id).ownerId == request.auth.uid;
    }

    function hasTeamAccess(id) {
      return isMember(id) || isTeamOwner(id);
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /tasks/{taskId} {
      allow read: if request.auth != null && (
        (resource.data.get('teamId', null) == null
          && resource.data.userId == request.auth.uid)
        || (resource.data.get('teamId', null) != null
          && hasTeamAccess(resource.data.teamId))
      );

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && (request.resource.data.get('teamId', null) == null
          || hasTeamAccess(request.resource.data.teamId));

      allow update: if request.auth != null
        && (
          (resource.data.get('teamId', null) == null
            && resource.data.userId == request.auth.uid)
          || (resource.data.get('teamId', null) != null
            && hasTeamAccess(resource.data.teamId))
        )
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.get('teamId', null) == resource.data.get('teamId', null);

      allow delete: if request.auth != null && (
        (resource.data.get('teamId', null) == null
          && resource.data.userId == request.auth.uid)
        || (resource.data.get('teamId', null) != null
          && hasTeamAccess(resource.data.teamId)
          && (resource.data.userId == request.auth.uid
            || isTeamOwner(resource.data.teamId)))
      );
    }

    match /teams/{teamId} {
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.memberIds
        || resource.data.ownerId == request.auth.uid
      );

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 0;

      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds is list
        && !(request.auth.uid in request.resource.data.memberIds);

      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
